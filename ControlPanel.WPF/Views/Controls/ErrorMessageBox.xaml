<Window
    x:Class="ControlPanel.Presentation.WPF.Views.Controls.ErrorMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:ControlPanel.Presentation.WPF.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="An error occured"
    MinWidth="420"
    MaxWidth="560"
    Background="#F7F7F8"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="56"
                    Height="56"
                    VerticalAlignment="Top"
                    CornerRadius="28">
                    <icons:MaterialIcon
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#D94841"
                        Kind="AlertCircleOutline" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="16,4,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#2B2B2B"
                    LineHeight="22"
                    Text="{Binding Message, RelativeSource={RelativeSource AncestorType=local:ErrorMessageBox}}"
                    TextWrapping="Wrap" />
            </Grid>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="OkButton"
                    Height="36"
                    MinWidth="96"
                    Padding="20,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#D94841"
                    BorderThickness="0"
                    Click="OkButton_Click"
                    Content="OK"
                    Cursor="Hand"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    IsCancel="True"
                    IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#C23B35" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#A8322D" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.95" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
