<Window
    x:Class="ControlPanel.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ControlPanel.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1920"
    Height="1080"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="8,10" Orientation="Vertical">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding Title}" />
            <TextBlock HorizontalAlignment="Center" Text="MENU" />
            <Button
                Margin="0,2"
                Command="{Binding OpenConfigurationPageCommand}"
                Content="Open Configuration" />
            <Button
                Margin="0,2"
                Command="{Binding OpenSimpleControlPageCommand}"
                Content="Open Simple Control" />
            <Button
                Margin="0,2"
                Command="{Binding OpenSequenceManagmentPageCommand}"
                Content="Open Sequence Managment" />

        </StackPanel>
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>
