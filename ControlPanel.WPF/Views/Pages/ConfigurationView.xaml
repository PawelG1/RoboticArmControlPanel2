<UserControl
    x:Class="ControlPanel.Presentation.WPF.Views.Pages.ConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ControlPanel.Presentation.WPF.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:ControlPanel.Presentation.WPF.Converters"
    xmlns:controls="clr-namespace:ControlPanel.Presentation.WPF.Views.Theme.Controls"
    Width="1280"
    Height="720"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <Control.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibiltyConverter"/>
        <converters:EmptyStringToVisibilityCollapsedConverter x:Key="EmptyStringToVisiblityCollapsedConverter"/>
        <converters:BooleanToVisibilityInvertedConverter x:Key="BooleanToVisibilityInvertedConverter"/>
    </Control.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="4">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="{Binding Title}" />
            <TextBlock Margin="4" Text="Choose COM Port" />
            <ComboBox
                Margin="4"
                ItemsSource="{Binding AvailableComPorts}"
                SelectedItem="{Binding SelectedComPortName}" />
            <Button
                Width="80"
                Margin="4"
                HorizontalAlignment="Right"
                Command="{Binding GetAvailableComPortsCommand}"
                Content="Refresh" />
            <Separator Margin="0,10" />
            <TextBlock Margin="4" Text="Choose Baud Rate" />
            <ComboBox
                Margin="4"
                ItemsSource="{Binding AvailableBaudRates}"
                SelectedItem="{Binding SelectedBaudRate}" >
            </ComboBox>
            <Separator Margin="0,10" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="5"
                    Command="{Binding ConnectCommand}"
                    Content="Connect" />
                <Button
                    Width="86"
                    Margin="5"
                    IsEnabled="{Binding IsConnected}"
                    Background="{StaticResource Brush.Danger}"
                    Command="{Binding DisconnectCommand}"
                    Content="Disconnect" />
            </StackPanel>

        </StackPanel>
        <!--  status  -->
        <StackPanel
            Grid.Column="1"
            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibiltyConverter}}"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Separator Margin="0,10" />
            <StackPanel Margin="4" Orientation="Vertical">
                <TextBlock Margin="4" Text="Status" />
                <TextBlock Margin="4" FontWeight="SemiBold" Text="Disconnected">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            <Setter Property="Text" Value="Disconnected" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                    <Setter Property="Text" Value="Connected" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Separator Margin="0,10" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibiltyConverter}}"/>

                <TextBlock Text="{Binding ListOfActuatorsAsText}" />

                <Separator Margin="0,10" />
                <CheckBox
                    Margin="4,0,4,8"
                    Content="Show raw log"
                    IsChecked="{Binding IsRawLogVisible, Mode=TwoWay}" />

                <Grid Width="900" Height="720"> 
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Raw Log -->
                    <StackPanel
                        Grid.Column="0"
                        Margin="4"
                        Visibility="{Binding IsRawLogVisible, Converter={StaticResource BoolToVisibiltyConverter}}">
                        <TextBlock Text="Raw Log" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Height="390">
                            <TextBox
                                IsReadOnly="True"
                                Text="{Binding CommunicationLog}"
                                TextChanged="TextBox_TextChanged" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Translated Log -->
                    <StackPanel Margin="4">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRawLogVisible}" Value="False">
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Translated Log" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Height="600">
                            <TextBox
                                IsReadOnly="True"
                                Text="{Binding TranslatedCommunicationLog}"
                                TextChanged="TextBox_TextChanged" />
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
                <Button
                    Height="auto"
                    Width="110"
                    Margin="4,0,4,8"
                    HorizontalAlignment="right"
                    Content="Export log"
                    IsEnabled="False" />
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>
