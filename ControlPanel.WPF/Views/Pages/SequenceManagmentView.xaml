<UserControl
    x:Class="ControlPanel.Presentation.WPF.Views.Pages.SequenceManagmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ControlPanel.Presentation.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ControlPanel.Presentation.WPF.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Control.Resources>
        <converters:EnumToStringConverter x:Key="EnumToStringConverter" />
        <converters:IsEqualConverter x:Key="IsEqualConverter" />
    </Control.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <GroupBox Height="auto" Header="">
                    <WrapPanel>
                        <ToggleButton Margin="4" Content="Loop Sequence" IsChecked="{Binding IsLooping}" />
                        <Button
                            Margin="4"
                            Command="{Binding ExecuteNextStepCommand}"
                            Content="Execute Step" />
                        <Button
                            Margin="4"
                            Command="{Binding ExecuteSequenceCommand}"
                            Content="Execute Sequence" />
                        <Button
                            Margin="4"
                            Command="{Binding StopSequenceCommand}"
                            Content="Stop Sequence" />
                        <Button
                            Margin="4"
                            Command="{Binding ExportSequenceFileCommand}"
                            Content="Export Sequence" />
                        <Button
                            Margin="4"
                            Command="{Binding ImportSequenceFileCommand}"
                            Content="Import Sequence" />
                        <Button
                            Margin="4"
                            Command="{Binding ClearSequenceCommand}"
                            Content="Clear Sequence" />

                    </WrapPanel>
                </GroupBox>
                <GroupBox Height="auto" Header="Control Robot">
                    <StackPanel Orientation="Vertical">
                        <ListView ItemsSource="{Binding Actuators}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" SharedSizeGroup="Col1" />
                                            <ColumnDefinition Width="auto" SharedSizeGroup="Col2" />
                                            <ColumnDefinition Width="auto" SharedSizeGroup="Col3" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding MinAngle, StringFormat='Min Value:{0}'}" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Text="{Binding MaxAngle, StringFormat='Max Value:{0}'}" />

                                        <Slider
                                            Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Width="200"
                                            Maximum="{Binding MaxAngle}"
                                            Minimum="{Binding MinAngle}"
                                            Value="{Binding TargetAngle}" />

                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Current Angle:{0:F2}  Target Angle:{1:F2}">
                                                    <Binding Path="CurrentAngle" />
                                                    <Binding Path="TargetAngle" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <DockPanel
                                            Grid.Row="3"
                                            Grid.ColumnSpan="3"
                                            Margin="0,4,0,2"
                                            LastChildFill="True">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                Text="Speed" />
                                            <TextBlock
                                                MinWidth="28"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                Text="{Binding Speed}" />
                                            <Slider
                                                IsSnapToTickEnabled="True"
                                                Maximum="255"
                                                Minimum="1"
                                                TickFrequency="1"
                                                Value="{Binding Speed}"
                                                VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Command="{Binding RecordStepCommand}" Content="Record Step" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBox Width="50" Text="{Binding DelaySeconds}" Margin="0,0,5,0" />
                            <TextBlock Text="sec " VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Command="{Binding AddDelayStepCommand}" Content="Add Delay Step" Width="100" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

            <GroupBox Grid.Column="1" Header="Recorded Steps:">
                <DataGrid
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding Steps}"
                    VerticalScrollBarVisibility="Visible">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Step.StepType, Converter={StaticResource EnumToStringConverter}}"
                            CanUserSort="False"
                            Header="Step Type" />
                        <DataGridTextColumn
                            Binding="{Binding Step.Delay}"
                            CanUserSort="False"
                            Header="Time" />
                        <DataGridTemplateColumn Header="Actuators">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Step.Pose.ActuatorTargets}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding ActuatorId}" Header="Id" />
                                            <DataGridTextColumn Binding="{Binding TargetAngle}" Header="Target Angle" />
                                            <DataGridTextColumn Binding="{Binding Speed}" Header="Speed" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNext}" Value="true">
                                    <Setter Property="Background" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="3D Visualisation">
                <ContentControl
                    Grid.Column="2"
                    Height="auto"
                    Content="{Binding RobotVisualiserView}" />

            </GroupBox>

        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBox
                Width="auto"
                MinWidth="720"
                MaxHeight="420"
                Margin="4"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Text="{Binding CommunicationLog}"
                VerticalScrollBarVisibility="Visible" />
        </Grid>
    </Grid>
</UserControl>
