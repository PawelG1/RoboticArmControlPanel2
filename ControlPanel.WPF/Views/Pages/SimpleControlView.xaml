<UserControl
    x:Class="ControlPanel.Presentation.WPF.Views.Pages.SimpleControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ControlPanel.Presentation.WPF.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vs="robot"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <GroupBox>
                <GroupBox.Header>
                    <TextBlock Text="Simple Joint Control" />
                </GroupBox.Header>
                <ListView ItemsSource="{Binding Actuators}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" SharedSizeGroup="Col1" />
                                    <ColumnDefinition Width="auto" SharedSizeGroup="Col2" />
                                    <ColumnDefinition Width="auto" SharedSizeGroup="Col3" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding MinAngle, StringFormat='Min Value:{0}'}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Text="{Binding MaxAngle, StringFormat='Max Value:{0}'}" />

                                <Slider
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Width="200"
                                    Maximum="{Binding MaxAngle}"
                                    Minimum="{Binding MinAngle}"
                                    Value="{Binding TargetAngle}" />

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="3">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Current Angle:{0:F2}  Target Angle:{1:F2}">
                                            <Binding Path="CurrentAngle" />
                                            <Binding Path="TargetAngle" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <DockPanel
                                    Grid.Row="3"
                                    Grid.ColumnSpan="3"
                                    Margin="0,4,0,2"
                                    LastChildFill="True">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Text="Speed" />
                                    <TextBlock
                                        MinWidth="28"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Text="{Binding Speed}" />
                                    <Slider
                                        VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True"
                                        Maximum="255"
                                        Minimum="1"
                                        TickFrequency="1"
                                        Value="{Binding Speed}" />
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding RobotVisualiserView}" />
    </Grid>
</UserControl>
