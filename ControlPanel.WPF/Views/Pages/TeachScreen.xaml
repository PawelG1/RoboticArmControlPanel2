<Page
    x:Class="ControlPanel.Presentation.WPF.Views.Pages.TeachScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ControlPanel.Presentation.WPF.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TeachScreen"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <GroupBox Header="" Height="auto">
                    <WrapPanel>
                        <ToggleButton Margin="4" Content="Start" />
                        <ToggleButton Margin="4" Content="Stop" />
                        <ToggleButton Margin="4" Content="Save" />
                        <ToggleButton Margin="4" Content="Import Program" />

                    </WrapPanel>
                </GroupBox>
                <Label Content="Recorded steps:" />
                <ListView />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <Label Content="Visualization" />
                <ContentControl Grid.Column="1" Content="{Binding RobotVisualiserView}" />
            </StackPanel>
        </Grid>

    </Grid>
</Page>
