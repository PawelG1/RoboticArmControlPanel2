<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Background">#0F1115</Color>
    <Color x:Key="Color.Surface">#171A21</Color>
    <Color x:Key="Color.SurfaceRaised">#181F30</Color>
    <Color x:Key="Color.Border">#D1FFFFFF</Color>

    <Color x:Key="Color.Primary">#3DA9FC</Color>
    <Color x:Key="Color.PrimaryHover">#63BBFD</Color>
    <Color x:Key="Color.PrimaryPressed">#2B8AD6</Color>
    <Color x:Key="Color.OnPrimary">#0B0D10</Color>

    <Color x:Key="Color.TextPrimary">#E6E9EF</Color>
    <Color x:Key="Color.TextMuted">#8B93A3</Color>

    <Color x:Key="Color.Success">#46CE59</Color>
    <Color x:Key="Color.Warning">#D29922</Color>
    <Color x:Key="Color.Danger">#F83D34</Color>
</ResourceDictionary>